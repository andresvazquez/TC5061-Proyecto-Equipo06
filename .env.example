# Configuración local de MiBici.
# Copia este archivo como .env y ajusta los valores según tu entorno.
# .env está ignorado por Git; no agregues credenciales reales aquí.

# Dirección del servidor de tracking de MLflow.
MLFLOW_TRACKING_URI=http://localhost:5000

# Tiempo máximo de espera de las peticiones HTTP a MLflow, en segundos (opcional).
# MLFLOW_HTTP_REQUEST_TIMEOUT=300
